# Copy to .env.local and fill in. NEVER commit .env.local (.gitignore covers .env*).
#
# Convex writes the first two itself when you run `npx convex dev` --
# you should not need to type them by hand.
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=

# Supabase Auth. Both are publishable by design -- safe in a client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# KLIPY (Green Screen Meme's meme popup: GIFs, clips, stickers, memes, AI emojis).
# Public by design -- Klipy requires its API to be called from the browser.
# Create a key at https://partner.klipy.com (API Keys). A new key is in Testing
# mode, capped at 100 requests an hour; request Production access there.
# Before going live, get Klipy's written OK (developers@klipy.com) for the
# render service fetching the picked meme server-side to burn it into the video.
NEXT_PUBLIC_KLIPY_APP_KEY=
